# syntax=docker/dockerfile:1.7-labs
# Context: a fresh directory containing exactly one .deb and smoke.py.
ARG UBUNTU_IMAGE=ubuntu:22.04@sha256:45e9ddc6895604674618a409ca9f73d301da8fdb75fe330e8e9a27b3b219e4ad
FROM ${UBUNTU_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libpam0g libgcc-s1 xdg-utils pinentry-gnome3 python3 \
    && useradd --create-home --uid 1100 --shell /bin/bash rbw-smoke \
    && install -d -o rbw-smoke -g rbw-smoke \
      /home/rbw-smoke/.config/rbw /home/rbw-smoke/.local/share/rbw /home/rbw-smoke/.cache/rbw \
    && for directory in /home/rbw-smoke/.config/rbw /home/rbw-smoke/.local/share/rbw /home/rbw-smoke/.cache/rbw; do \
         printf 'preserve-user-data\n' >"$directory/package-smoke-sentinel"; \
         chown rbw-smoke:rbw-smoke "$directory/package-smoke-sentinel"; \
       done
COPY *.deb /tmp/rbwbio.deb
COPY smoke.py /opt/rbwbio-package-smoke.py
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    python3 /opt/rbwbio-package-smoke.py snapshot-policy /tmp/policy-before.json \
    && apt-get update && apt-get install -y --no-install-recommends /tmp/rbwbio.deb \
    && python3 /opt/rbwbio-package-smoke.py compare-policy /tmp/policy-before.json \
    && rm /tmp/rbwbio.deb /tmp/policy-before.json
USER rbw-smoke
ENV HOME=/home/rbw-smoke XDG_CONFIG_HOME=/home/rbw-smoke/.config \
    XDG_DATA_HOME=/home/rbw-smoke/.local/share XDG_CACHE_HOME=/home/rbw-smoke/.cache
ENTRYPOINT ["python3", "/opt/rbwbio-package-smoke.py", "probe"]
