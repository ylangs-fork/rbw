# syntax=docker/dockerfile:1
FROM rust:1.85-bookworm AS builder
WORKDIR /src
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpam0g-dev openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add clippy rustfmt
COPY . .
RUN cargo test --all-targets \
    && cargo clippy --all-targets -- -D warnings \
    && cargo fmt --all -- --check \
    && cargo build --release --bins

RUN ssh-keygen -q -t ed25519 -N '' -C rbw-ssh-agent-e2e -f /tmp/id_ed25519 \
    && printf '%s\n' \
       '#!/bin/sh' \
       'while IFS= read -r line; do' \
       '  case "$line" in' \
       '    GETPIN) printf "%s\\n" "D rbw-e2e-password" "OK" ;;' \
       '    BYE) printf "%s\\n" "OK"; exit 0 ;;' \
       '    *) printf "%s\\n" "OK" ;;' \
       '  esac' \
       'done' \
       > /tmp/pinentry-e2e \
    && chmod 0755 /tmp/pinentry-e2e \
    && mkdir -p /tmp/e2e-home /tmp/e2e-runtime \
    && HOME=/tmp/e2e-home XDG_RUNTIME_DIR=/tmp/e2e-runtime RBW_PROFILE=ssha-e2e \
       RBW_E2E_PRIVATE_KEY=/tmp/id_ed25519 \
       RBW_E2E_PUBLIC_KEY=/tmp/id_ed25519.pub \
       RBW_E2E_PINENTRY=/usr/local/bin/pinentry-e2e \
       cargo test --test ssh_agent_e2e_fixture -- --ignored --exact create_ssh_agent_fixture

FROM ubuntu:24.04
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates git libpam0g openssh-client openssh-server tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1100 --shell /bin/bash rbw \
    && useradd --create-home --shell /bin/bash git \
    && mkdir -p /run/sshd /home/git/.ssh /home/git/repo.git /tmp/rbw-e2e-runtime \
    && chmod 0700 /home/git/.ssh /tmp/rbw-e2e-runtime \
    && chown -R git:git /home/git \
    && chown rbw:rbw /tmp/rbw-e2e-runtime
COPY --from=builder /src/target/release/rbw /usr/local/bin/rbw
COPY --from=builder /src/target/release/rbw-agent /usr/local/bin/rbw-agent
COPY --from=builder /tmp/pinentry-e2e /usr/local/bin/pinentry-e2e
COPY --from=builder /tmp/id_ed25519.pub /tmp/id_ed25519.pub
COPY --from=builder --chown=rbw:rbw /tmp/e2e-home/ /home/rbw/
RUN cp /tmp/id_ed25519.pub /home/git/.ssh/authorized_keys \
    && chown git:git /home/git/.ssh/authorized_keys \
    && chmod 0600 /home/git/.ssh/authorized_keys \
    && runuser -u git -- git init --bare /home/git/repo.git \
    && ssh-keygen -A
COPY tests/ssh_agent_docker_e2e.sh /usr/local/bin/ssh-agent-e2e
RUN chmod 0755 /usr/local/bin/ssh-agent-e2e
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/ssh-agent-e2e"]
