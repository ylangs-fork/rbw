FROM rust:1.85-bookworm AS builder

# Install PAM dev headers (required to link rbw's PAM gate) and other build deps.
# Clean apt lists/cache first to free space, then install.
RUN rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        libpam0g-dev \
        pkg-config \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Add rustfmt + clippy components
RUN rustup component add rustfmt clippy

# Verify the PAM .so symlink exists (linker needs -lpam)
RUN ls -l /usr/lib/x86_64-linux-gnu/libpam.so

WORKDIR /src
COPY . .

# Full validation gate (mirrors worker reports)
RUN cargo fmt --all -- --check
RUN cargo clippy --all-targets -- -D warnings
RUN cargo test --all-targets
